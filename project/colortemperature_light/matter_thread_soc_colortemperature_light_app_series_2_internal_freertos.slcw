---
workspace_name: "matter_thread_soc_colortemperature_light_app_series_2_internal_freertos"
label: "Matter Thread - SoC Color Temperature Light with internal Bootloader FreeRTOS"
quality: "production"
package: "matter"
description: "Demonstrates a sample implementation of a Matter over Thread color temperature light\
  \ app with internal bootloader"
project:
- id: "application"
  path: "colortemperature_light_app/matter_thread_soc_colortemperature_light_app_freertos.slcp"
  output: "colortemperature_light_app"
- id: "bootloader"
  path: "matter_bootloader/matter_bootloader_internal_series_2.slcp"
  output: "matter_bootloader"
post_build:
  profile: ""
  path: "matter_thread_soc_colortemperature_light_app_series_2_internal_freertos.slpb"
