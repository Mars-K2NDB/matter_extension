---
workspace_name: "matter_thread_soc_onoff_plug_app_series_2_internal_freertos"
label: "Matter Thread - SoC Onoff Plug with internal Bootloader FreeRTOS"
quality: "production"
package: "matter"
description: "Demonstrates a sample implementation of a Matter over Thread on/off\
  \ plug app with internal bootloader"
project:
- id: "application"
  path: "onoff_plug_app/matter_thread_soc_onoff_plug_app_freertos.slcp"
  output: "onoff_plug_app"
- id: "bootloader"
  path: "matter_bootloader/matter_bootloader_internal_series_2.slcp"
  output: "matter_bootloader"
post_build:
  profile: ""
  path: "matter_thread_soc_onoff_plug_app_series_2_internal_freertos.slpb"
