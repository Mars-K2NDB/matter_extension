---
parameters: []
constants:
- name: "workspace_name"
  value: "matter_thread_soc_extended_color_light_app_series_2_internal_freertos"
- path: "extended_color_light_app/matter_thread_soc_extended_color_light_app_freertos.slpb"
- path: "matter_bootloader/matter_bootloader_internal_series_2.slpb"
steps:
- task: "convert"
  output: "artifact/{{workspace_name}}_full.s37"
  input:
  - "{{bootloader_binary}}"
  - "{{application_binary}}"
- task: "create_gbl"
  output: "artifact/{{workspace_name}}_app_only.gbl"
  app: "{{application_binary}}"
