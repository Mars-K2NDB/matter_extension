project_name: matter_bootloader_internal_series_2
label: Matter - SoC Bootloader Internal Storage Series 2
description: Demonstrates a bootloader configuration using internal storage for Matter
  firmware updates on Series 2 devices
category: Matter Application
filter:
- name: Difficulty
  value:
  - Advanced
- name: Type
  value:
  - SoC
- name: Wireless Technology
  value:
  - Matter
package: matter
quality: production
readme:
- path: readme.md
sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2025.12.2
toolchain_settings: []
component:
- package: matter
  vendor: silabs
  id: matter_syscall_stubs
- package: simplicity_sdk
  vendor: silabs
  id: bootloader_aes_sha_ecdsa
- package: simplicity_sdk
  vendor: silabs
  id: bootloader_common_storage
- package: simplicity_sdk
  vendor: silabs
  id: bootloader_compression_lzma
- package: simplicity_sdk
  vendor: silabs
  id: bootloader_core
- package: simplicity_sdk
  vendor: silabs
  id: bootloader_crc
- package: simplicity_sdk
  vendor: silabs
  id: bootloader_debug
- package: simplicity_sdk
  vendor: silabs
  id: bootloader_gbl_compression_lz4
- package: simplicity_sdk
  vendor: silabs
  id: bootloader_image_parser
- package: simplicity_sdk
  vendor: silabs
  id: bootloader_internal_storage
- package: simplicity_sdk
  vendor: silabs
  id: bootloader_storage_slots
- package: simplicity_sdk
  vendor: silabs
  id: bootloader_token_management
- package: simplicity_sdk
  vendor: silabs
  id: psa_crypto_config
- package: simplicity_sdk
  vendor: silabs
  id: brd2703a
configuration:
- name: SLOT0_ENABLE
  value: '1'
- unless:
  - device_sdid_225
  name: SLOT0_SIZE
  value: '557056'
- condition:
  - device_sdid_200
  name: BTL_STORAGE_BASE_ADDRESS
  value: '278528'
- condition:
  - device_sdid_200
  name: SLOT0_START
  value: '278528'
- condition:
  - device_sdid_205
  name: BTL_STORAGE_BASE_ADDRESS
  value: '278528'
- condition:
  - device_sdid_205
  name: SLOT0_START
  value: '278528'
- condition:
  - device_sdid_210
  name: BTL_STORAGE_BASE_ADDRESS
  value: '134496256'
- condition:
  - device_sdid_210
  name: SLOT0_START
  value: '134496256'
- condition:
  - device_sdid_215
  name: BTL_STORAGE_BASE_ADDRESS
  value: '135176192'
- condition:
  - device_sdid_215
  name: SLOT0_START
  value: '135176192'
- condition:
  - device_sdid_215
  name: BOOTLOADER_MSC_DMA_CHANNEL
  value: '4'
- condition:
  - device_sdid_220
  name: BTL_STORAGE_BASE_ADDRESS
  value: '134496256'
- condition:
  - device_sdid_220
  name: SLOT0_START
  value: '134496256'
- condition:
  - device_sdid_225
  name: BTL_STORAGE_BASE_ADDRESS
  value: '135847936'
- condition:
  - device_sdid_225
  name: SLOT0_START
  value: '135847936'
- condition:
  - device_sdid_225
  name: SLOT0_SIZE
  value: '1589248'
- condition:
  - device_sdid_230
  name: BTL_STORAGE_BASE_ADDRESS
  value: '134496256'
- condition:
  - device_sdid_230
  name: SLOT0_START
  value: '134496256'
- name: BOOTLOADER_MSC_DMA_WRITE
  value: '0'
ui_hints:
  highlight:
  - path: readme.md
sdk_extension:
- vendor: silabs
  id: wiseconnect3_sdk
  version: 4.0.1
- vendor: silabs
  id: matter
  version: 2.8.1
post_build:
- path: matter_bootloader_internal_series_2.slpb
  profile: bootloader_series_2
