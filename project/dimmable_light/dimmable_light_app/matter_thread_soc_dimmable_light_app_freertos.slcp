project_name: matter_thread_soc_dimmable_light_app_freertos
label: Matter Thread - SoC Dimmable Light FreeRTOS
description: Demonstrates a sample implementation of a Matter over Thread dimmable
  light app
category: Matter Application
filter:
- name: Difficulty
  value:
  - Advanced
- name: Type
  value:
  - SoC
- name: Wireless Technology
  value:
  - Matter
package: matter
quality: production
