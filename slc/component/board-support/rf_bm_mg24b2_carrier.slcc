!!omap
- id: rf_bm_mg24b2_carrier
- label: RF-BM-MG24B2 carrier
- package: matter
- description: Carrier board defaults for RF-BM-MG24B2 (LED/button/VCOM instances).
- category: Platform|Board|Custom
- quality: production
- metadata:
    sbom:
      license: Zlib
- requires:
  - name: efr32mg24a420f1536im48
  - name: rf_bm_mg24b2_config
- provides:
  - name: rf_bm_mg24b2_revision
  - name: rf_bm_mg24b2_carrier
  - name: hardware_board
  - name: hardware_board_has_vcom
  - name: hardware_board_has_vcom_hardware_flowcontrol
  - name: board_config_clock_manager
  - name: hardware_board_has_hfxo_freq_39mhz
  - name: hardware_board_has_hfxo
  - name: hardware_board_has_lfxo
  - name: hardware_board_supports_rf_band_2400
  - name: hardware_board_supports_1_rf_band
  - name: hardware_board_default_rf_band
  - name: hardware_board_default_rf_band_2400
- recommends:
  - id: iostream_eusart
    instance:
    - vcom
    vendor: silabs
  - id: simple_led
    instance:
    - led0
    - led1
    vendor: silabs
  - id: simple_button
    instance:
    - btn0
    - btn1
    vendor: silabs
- define:
  - name: SL_BOARD_NAME
    value: '"RF-BM-MG24B2"'
  - name: SL_BOARD_REV
    value: '"carrier"'
  - name: HFXO_FREQ
    value: 39000000
  - name: HARDWARE_BOARD_SUPPORTS_RF_BAND_2400
  - name: HARDWARE_BOARD_SUPPORTS_1_RF_BAND
  - name: HARDWARE_BOARD_DEFAULT_RF_BAND_2400
- tag:
  - board:device:efr32mg24a420f1536im48
  - hardware:has:vcom
  - hardware:has:vcom:vcom_hardware_flowcontrol
  - hardware:has:led:2
  - hardware:has:button:2
- root_path: slc/component/board-support
